 "raised_families": {
  "_about": "Raised pose per gun: game pose + s * dir (idle clips) or s * aim_dir (aim), in metres, right hand (x = right, y = up, z = back); roll in degrees about the barrel and clavicle scaled by min(1, s / s_ref). The muzzle direction never changes. target: screen cover (percent, one gun) the autotune stops at.",
  "C": {"name": "hip carry", "dir": [0.15, -1.0, 0.25], "aim_dir": [0.2, -0.6, 0.0], "roll": -10, "clavicle": [0, 0, 0], "s_ref": 0.15, "target": 5.5, "s_max": 0.20}
 },
 "checks": {
  "_about": "Thresholds of build.sh check. baseline = the worst value measured on the shipped clips (3.2.0), kept as the limit; the others are the documented rules.",
  "endpose": {
   "end_max_cm": 0.01,
   "end_max_deg": 0.01,
   "unchanged_max": 0.0001,
   "hand_dev_max_cm": 0.05,
   "hand_dev_max_deg": 0.1,
   "_note": "Last frame against idlepose_shoulder, per hand, world space (shipped worst 0.003 cm, 0.007 deg). Frames before the seated frame equal the clip before the fix (cm or deg). Hands and guns keep their path over the fix (baseline 0.04 cm, 0.08 deg)."
  },
  "sets": {
   "fps": 30,
   "duration_tolerance_s": 0.0001,
   "resampled_baseline": [[139, 138], [121, 120], [43, 42], [16, 15], [26, 25], [46, 45]],
   "_note": "Shipped clips are SIMD buffers (a compressed buffer breaks the first-person camera) and keep the key count of the glb they were imported from. resampled_baseline: [glb keys, frames in the set] of the shipped clips that do not (per-hand reload 139, lowered 121, 43, 16, raised pose sets 26 (vault, idlepose_frenzy) and 16, a raised gun's melee 46: the import stores one frame less and resamples); 96 and 112 keys come back exact."
  },
  "topmag": {
   "const_quat_w": 0,
   "hand_on_gun_cm": 0.1,
   "contact_miss_long_cm": 1.0,
   "contact_depth_long_cm": 0.5,
   "contact_miss_smg_cm": 2.5,
   "contact_depth_smg_cm": 1.7,
   "contact_miss_pair_cm": 2.0,
   "contact_depth_pair_cm": 0.9,
   "hands_gap_cm": 0.1,
   "wrist_deg": 113.0,
   "hidden_frames": 0,
   "hidden_speed_cm": 0.85,
   "eye_long_cm": 20.0,
   "eye_smg_cm": 0.5,
   "face_cover_pts": 3.0,
   "_note": "Sources per limit: THRESHOLDS in authoring/topmag/checks.py. Baselines (shipped worst, the documented rule is stricter and the shipped clips miss it): contact_miss_smg_cm 2.5 (rule 2.0; Burya on right uppercut top_std 2.48), hidden_speed_cm 0.85 (rule: nearly still; pair_SS_scissor 0.81, pair_SS_clap 0.5), eye_smg_cm 0.5 (tables: 5; doubletap category clips with Warden, Borg, Shingen, Dian, generic SMG). Also baselines: hand_on_gun_cm, contact_depth_pair_cm, hands_gap_cm, wrist_deg."
  },
  "magtrack": {
   "still": 1e-09,
   "scale": 1e-06,
   "first_move": 1,
   "exit": 25,
   "eye": 20,
   "rise": 12,
   "accel": 0,
   "reversal": 0,
   "reappear": 0,
   "hidden_by": 12,
   "restrike": 5,
   "screen_exit": 25,
   "screen_motion": 0,
   "size": 1.4,
   "insert_visible": 0,
   "seated_by": 64,
   "empty_same": 1e-05,
   "empty_tail": 1e-09,
   "contact": 0.5,
   "touch_gap": 0,
   "_note": "The flight gates of authoring/magtrack/mag_flight.py. The shipped tracks miss exit (4 picks, up to 46.2 deg), contact (2 picks) and touch_gap (8 picks); those items are accepted at their recorded values in authoring/magtrack/baseline.json and marked baseline in the output."
  },
  "roundtrip": {
   "hand_max_cm": 0.85,
   "hand_max_deg": 0.85,
   "any_max_cm": 8.0,
   "_note": "Built set exported back by WolvenKit against the glb it was imported from. Baselines of one set of each kind: hands and guns 0.80 cm, 0.80 deg (the per-hand reload set, resampled by the import), any arm joint 7.9 cm (a finger joint in a category set)."
  },
  "rreload": {"camera": {"eye": [0, 1.61, -0.02], "hfov_169": 105.0}, "end_max_cm": 0.02, "end_max_deg": 0.02, "eye_min_cm": 20.0, "cover_max_pct": 18.0, "wrist_max_deg": 113.0, "wrist_view_max_deg": 70.0, "reach_max": 0.985, "shoulder_pull_max_cm": 3.0, "body_min_cm": -5.0, "mag_hang_frames": 0, "release_dv_max_cm_f": 1.5, "off_axis_max_cm": 1.5, "hidden_min_frames": 12, "_note": "Rifle reload clips (authoring/reload/rgate.py). end: first and last frame against the gun's raised idle, own arm. hidden: between hide_start and hide_end the gun, its hand and forearm and every magazine are off screen in first person; the window holds the seat and must not hold the handle hit. mag_hang: frames a detached magazine is in the air and not in free fall. release_dv: jump of the magazine's world velocity where the guided slide ends and the free fall starts, gravity taken off. off_axis: sideways offset from the well axis in the last 10 cm of the insertion and the first 10 cm of the exit. Key counts are padded to rarmset.good_keys (import test in production/import_length)."},
  "lowered": {
   "pair_reference": "carnage",
   "seam_max": 0.0005,
   "eye_min_cm": 25,
   "eye_closer_than_raised_max_cm": 0.95,
   "gun_gap_min_cm": 17.6,
   "wrist_idle_max_deg": 20,
   "wrist_max_deg": 37.5,
   "autotune_top_edge": -0.78,
   "_note": "seam: loop seam and clip ends against the idle's first frame, cm or deg. eye_min_cm: closest gun point in the lowered idle. eye_closer_than_raised_max_cm: baseline 0.91 (two Zhuos; 0.7 with a Dian): where a gun is under eye_min_cm, safe_action may come this much nearer than the game's raised pose. gun_gap_min_cm: baseline, Satara + Carnage in the game's raised pose; a pair that is closer in the raised pose (two Sataras, 14.0) must not get closer than that. wrist_idle_max_deg: the autotune rule. wrist_max_deg: baseline, v2 equip_safe."
  },
  "raised": {
   "camera": {"eye": [0, 1.61, -0.02], "hfov_169": 105.0},
   "limit_pct": 8.5,
   "step": 0.005,
   "reach_max": 0.955,
   "wrist_max_deg": 45,
   "wrist_vs_game_max_deg": 30,
   "eye_min_cm": 17.0,
   "gap_min_cm": 17.6,
   "cover_over_target_max_pct": 0.1,
   "muzzle_max_deg": 0.01,
   "grip_max_cm": 0.01,
   "end_max_cm": 0.02,
   "end_max_deg": 0.02,
   "pose_clip_extra_cm": 0.05,
   "hand_clip_end_max_cm": 0.6,
   "topmag_window": [10, 46],
   "topmag_back_by": 60,
   "_note": "camera: eye and horizontal fov (16:9) of the metric, fitted to game screenshots of 2026-11-11. limit_pct: the autotune reports a gun without a raised entry that covers more than this in the game pose (Ajax 8.0, Sidewinder 9.3, Masamune 15.0). reach: shoulder to wrist over arm length in the idle. wrist: bend from the bind pose (game pose 43) and change against the game pose. eye_min_cm, gap_min_cm: or the game pose value where that is lower. end_max: reload clips and top-magazine clips against the gun's raised idle, first and last frame. pose_clip_extra_cm: a pose clip may miss the raised idle by what the game clip misses the game idle, plus this. hand_clip_end_max_cm: equip end, unequip start, melee ends against the raised idle (baseline: the Lexington clips miss the game idle by up to 0.5 cm at the hand). topmag_window: frames of a top-magazine clip left untouched: the partner arm eases out of its raised pose before the first, and back into it between the second and topmag_back_by, while the guns are down out of view, so it rises straight into the raised pose (eased over the rise it came up at pistol height and sank: seen in game). end_max_cm 0.02: the reload clips made from the empty reload differ from the idle by the body pose of that clip, 0.011 cm."
  }
 },
