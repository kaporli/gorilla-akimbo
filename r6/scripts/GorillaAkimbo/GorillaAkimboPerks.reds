    ArrayPush(rnew, "NewPerks.Reflexes_Left_Perk_2_3_inline3_GA_R");
    ArrayPush(rnew, "NewPerks.Reflexes_Left_Perk_2_3_inline3_GA_L");
    ArrayPush(rnew, "NewPerks.Reflexes_Left_Perk_2_4_inline3_GA_R");
    ArrayPush(rnew, "NewPerks.Reflexes_Left_Perk_2_4_inline3_GA_L");
    ArrayPush(rnew, "NewPerks.Reflexes_Left_Perk_3_2_inline3_GA_R");
    ArrayPush(rnew, "NewPerks.Reflexes_Left_Perk_3_2_inline3_GA_L");
    ArrayPush(rnew, "BaseStatusEffect.Reflexes_Sharpshooter_Crit_Stack_inline5_GA_R");
    ArrayPush(rnew, "BaseStatusEffect.Reflexes_Sharpshooter_Crit_Stack_inline5_GA_L");
    ArrayPush(rnew, "BaseStatusEffect.Reflexes_Sharpshooter_AP_Stack_inline5_GA_R");
    ArrayPush(rnew, "BaseStatusEffect.Reflexes_Sharpshooter_AP_Stack_inline5_GA_L");
    ArrayPush(rnew, "NewPerks.Reflexes_Master_Perk_1_StatusEffect_inline5_GA_R");
    ArrayPush(rnew, "NewPerks.Reflexes_Master_Perk_1_StatusEffect_inline5_GA_L");
    ArrayPush(rnew, "NewPerks.Reflexes_Master_Perk_2_inline3_GA_R");
    ArrayPush(rnew, "NewPerks.Reflexes_Master_Perk_2_inline3_GA_L");
    ArrayPush(rnew, "NewPerks.Reflexes_Master_Perk_2_inline7_GA_R");
    ArrayPush(rnew, "NewPerks.Reflexes_Master_Perk_2_inline7_GA_L");
    ArrayPush(rnew, "NewPerks.Tech_Right_Milestone_3_inline3_GA_R");
    ArrayPush(rnew, "NewPerks.Tech_Right_Milestone_3_inline3_GA_L");
    ArrayPush(rnew, "NewPerks.Tech_Right_Milestone_3_inline9_GA_R");
    ArrayPush(rnew, "NewPerks.Tech_Right_Milestone_3_inline9_GA_L");
    ArrayPush(rnew, "BaseStatusEffect.Tech_Right_Milestone_3_Buff_inline3_GA_R");
    ArrayPush(rnew, "BaseStatusEffect.Tech_Right_Milestone_3_Buff_inline3_GA_L");
    ArrayPush(rnew, "NewPerks.Tech_Right_Perk_3_3_inline5_GA_R");
    ArrayPush(rnew, "NewPerks.Tech_Right_Perk_3_3_inline5_GA_L");
    ArrayPush(rnew, "BaseStatusEffect.Tech_Right_Perk_3_4_Buff_inline6_GA_R");
    ArrayPush(rnew, "BaseStatusEffect.Tech_Right_Perk_3_4_Buff_inline6_GA_L");
    let i = 0;
    while i < ArraySize(rcont) {
      let rc = TDBID.Create(rcont[i]);
      let rl = TweakDBInterface.GetForeignKeyArray(rc + t".effectors");
      let changed = ArrayRemove(rl, TDBID.Create(rold[i]));
      let rn = TDBID.Create(rnew[i]);
      if !ArrayContains(rl, rn) {
        ArrayPush(rl, rn);
        changed = true;
      }
      if changed {
        TweakDBManager.SetFlat(rc + t".effectors", rl);
        TweakDBManager.UpdateRecord(rc);
      }
      i += 1;
    }
    i = 0;
    while i < ArraySize(containers) {
      let container = TDBID.Create(containers[i]);
      let list = TweakDBInterface.GetForeignKeyArray(container + t".effectors");
      let id = TDBID.Create(added[i]);
      if !ArrayContains(list, id) {
        ArrayPush(list, id);
        TweakDBManager.SetFlat(container + t".effectors", list);
        TweakDBManager.UpdateRecord(container);
      }
      i += 1;
    }
  }
}

// Per-effector weapon types for the scripted effectors that read the weapons themselves (generated from the audit).
public abstract class GorillaAkimboPerkTypes {
  public static func Allows(record: TweakDBID, weapon: wref<WeaponObject>) -> Bool {
    if record == t"NewPerks.Reflexes_Master_Perk_1_inline3" {
      return GorillaAkimboHitWeaponCondition.Matches(weapon, ["Wea_Rifle"], []);
    }
    if record == t"NewPerks.Body_Master_Perk_2_inline4" {
      return GorillaAkimboHitWeaponCondition.Matches(weapon, ["Wea_LightMachineGun"], []);
    }
    return true;
  }
}

// ReflexesMasterPerk1Effector keeps its own hit history from every hit of the player, whatever the weapon. Ignore other guns' hits.
// A miss clears the streak. Only misses of the matching gun type may do that.
@wrapMethod(ReflexesMasterPerk1EffectorListener)
protected func OnMissTriggered(missEvent: ref<gameMissEvent>) -> Void {
  if !GorillaAkimboPerkTypes.Allows(this.m_owner.GetRecord(), missEvent.attackData.GetWeapon()) {
    return;
  }
  wrappedMethod(missEvent);
}

@wrapMethod(ReflexesMasterPerk1Effector)
public final func StoreHitEvent(hitEvent: ref<gameHitEvent>) -> Void {
  if !GorillaAkimboPerkTypes.Allows(this.GetRecord(), hitEvent.attackData.GetWeapon()) {
    return;
  }
  wrappedMethod(hitEvent);
}

// CeaselessLeadAmmoEffector refunds ammo on every active weapon. Only refund guns of the perk's type.
@replaceMethod(CeaselessLeadAmmoEffector)
private final func ProcessAction(owner: ref<GameObject>) -> Void {
  let refundEvent: ref<SetAmmoCountEvent>;
  let weapon: wref<WeaponObject>;
  let weapons: array<wref<WeaponObject>> = ScriptedPuppet.GetActiveWeapons(owner);
  let i: Int32 = 0;
  while i < ArraySize(weapons) {
    weapon = weapons[i];
    if IsDefined(weapon) && GorillaAkimboPerkTypes.Allows(this.GetRecord(), weapon) && WeaponObject.HasAvailableAmmoInInventory(weapon) && WeaponObject.GetMagazineCapacity(weapon) > WeaponObject.GetMagazineAmmoCount(weapon) && Cast<Float>(WeaponObject.GetMagazineCapacity(weapon)) * this.m_percentToRefund >= 1.00 {
      refundEvent = new SetAmmoCountEvent();
      refundEvent.ammoTypeID = WeaponObject.GetAmmoType(weapon);
      refundEvent.count = Cast<Uint32>(Cast<Float>(WeaponObject.GetMagazineCapacity(weapon)) * this.m_percentToRefund) + WeaponObject.GetMagazineAmmoCount(weapon);
      weapon.QueueEvent(refundEvent);
      GameObject.PlaySoundEvent(owner, n"w_gun_perk_ceaseless_lead");
    }
    i += 1;
  }
}
