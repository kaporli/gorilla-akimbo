// Gorilla Akimbo: per-gun perks. Generated by perkcheck\gen.py from the audit table. Do not edit by hand.
// Companion of tweaks/GorillaAkimbo/GorillaAkimboPerks.yaml.
module GorillaAkimbo

// Weapon types and evolutions of each HitWeapon record from the yaml. TweakXL rejects custom flats, so
// the lists live here (generated from the audit).
public abstract class GorillaAkimboHitTable {
  public static func Lookup(id: TweakDBID, out types: array<String>, out evolutions: array<String>) -> Bool {
    if id == t"GorillaAkimboPerks.HitWeapon_356604ae" {
      types = ["Wea_HeavyMachineGun", "Wea_LightMachineGun", "Wea_Shotgun", "Wea_ShotgunDual"];
      evolutions = [];
      return true;
    }
    if id == t"GorillaAkimboPerks.HitWeapon_f78db987" {
      types = ["Wea_Shotgun", "Wea_ShotgunDual"];
      evolutions = [];
      return true;
    }
    if id == t"GorillaAkimboPerks.HitWeapon_5eab4b6e" {
      types = ["Wea_LightMachineGun"];
      evolutions = [];
      return true;
    }
    if id == t"GorillaAkimboPerks.HitWeapon_d2133e59" {
      types = ["Wea_Handgun", "Wea_PrecisionRifle", "Wea_Revolver", "Wea_SniperRifle"];
      evolutions = [];
      return true;
    }
    if id == t"GorillaAkimboPerks.HitWeapon_d99bb3fb" {
      types = ["Wea_PrecisionRifle", "Wea_Revolver", "Wea_SniperRifle"];
      evolutions = [];
      return true;
    }
    if id == t"GorillaAkimboPerks.HitWeapon_b246c83a" {
      types = [];
      evolutions = ["Smart"];
      return true;
    }
    if id == t"GorillaAkimboPerks.HitWeapon_497ffdda" {
      types = ["Wea_AssaultRifle", "Wea_Rifle", "Wea_SubmachineGun"];
      evolutions = [];
      return true;
    }
    if id == t"GorillaAkimboPerks.HitWeapon_90110fee" {
      types = ["Wea_Rifle"];
      evolutions = [];
      return true;
    }
    if id == t"GorillaAkimboPerks.HitWeapon_9e0f92aa" {
      types = [];
      evolutions = ["Tech"];
      return true;
    }
    return false;
  }
}

// Hit condition for the HitWeapon records: true when the attacking weapon matches any listed value.
public class GorillaAkimboHitWeaponCondition extends BaseHitPrereqCondition {
  private let m_types: array<String>;
  private let m_evolutions: array<String>;

  public func SetData(recordID: TweakDBID, types: array<String>, evolutions: array<String>) -> Void {
    super.SetData(recordID);
    this.m_types = types;
    this.m_evolutions = evolutions;
  }

  public static func Matches(weapon: wref<WeaponObject>, types: array<String>, evolutions: array<String>) -> Bool {
    if !IsDefined(weapon) {
      return false;
    }
    let id = weapon.GetItemID();
    if ArrayContains(types, EnumValueToString("gamedataItemType", Cast<Int64>(EnumInt(RPGManager.GetItemType(id))))) {
      return true;
    }
    if ArrayContains(evolutions, EnumValueToString("gamedataWeaponEvolution", Cast<Int64>(EnumInt(RPGManager.GetWeaponEvolution(id))))) {
      return true;
    }
    return false;
  }

  public func Accepts(weapon: wref<WeaponObject>) -> Bool {
    return GorillaAkimboHitWeaponCondition.Matches(weapon, this.m_types, this.m_evolutions);
  }

  public func Evaluate(hitEvent: ref<gameHitEvent>) -> Bool {
    let result = GorillaAkimboHitWeaponCondition.Matches(hitEvent.attackData.GetWeapon(), this.m_types, this.m_evolutions);
    if result {
      result = this.CheckOnlyOncePerShot(hitEvent);
    }
    return this.m_invert ? !result : result;
  }
}

@wrapMethod(GenericHitPrereq)
public final static func CreateHitCondition(record: ref<HitPrereqCondition_Record>) -> ref<BaseHitPrereqCondition> {
  let typeList: array<String>;
  let evolutionList: array<String>;
  let id = record.GetID();
  if GorillaAkimboHitTable.Lookup(id, typeList, evolutionList) {
    let condition = new GorillaAkimboHitWeaponCondition();
    condition.SetData(id, typeList, evolutionList);
    return condition;
  }
  return wrappedMethod(record);
}

// The generic hit prereq forwards every miss to all its conditions. ConsecutiveHitsPrereqCondition resets its streak on any miss.
// When the prereq has a weapon gate (HitWeapon_*), a miss by a gun the gate rejects must not reach the other conditions.
// A miss with no weapon, and any prereq without a gate, keep the vanilla path.
@wrapMethod(GenericHitPrereqState)
public func OnMissTriggered(missEvent: ref<gameMissEvent>) -> Void {
  let prereq = this.GetPrereq() as GenericHitPrereq;
  let weapon = missEvent.attackData.GetWeapon();
  if IsDefined(prereq) && IsDefined(weapon) {
    let i = 0;
    while i < ArraySize(prereq.m_conditions) {
      let gate = prereq.m_conditions[i] as GorillaAkimboHitWeaponCondition;
      if IsDefined(gate) && !gate.m_invert && !gate.Accepts(weapon) {
        return;
      }
      i += 1;
    }
  }
  wrappedMethod(missEvent);
}

