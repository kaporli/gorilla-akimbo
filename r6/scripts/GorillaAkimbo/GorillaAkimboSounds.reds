// Generated by gensounds.py from each weapon's two-handed reload clips: the sound events of its reload
// (empty: of its empty reload), in clip seconds at its base reload time.
module GorillaAkimbo

public abstract class GorillaAkimboSounds {
  public static func Fallback(audio: CName, type: gamedataItemType, shells: Bool) -> CName {
    if Equals(type, gamedataItemType.Wea_SubmachineGun) {
      return n"wea_set_saratoga";
    }
    if Equals(type, gamedataItemType.Wea_ShotgunDual) {
      return n"wea_set_igla";
    }
    return shells ? n"wea_set_carnage" : n"wea_set_crusher";
  }

  public static func Has(audio: CName) -> Bool {
    switch audio {
      case n"wea_set_borg4a":
      case n"wea_set_carnage":
      case n"wea_set_crusher":
      case n"wea_set_dian":
      case n"wea_set_igla":
      case n"wea_set_palica":
      case n"wea_set_pozhar":
      case n"wea_set_pulsar":
      case n"wea_set_saratoga":
      case n"wea_set_satara":
      case n"wea_set_senkoh":
      case n"wea_set_senkoh_prototype":
      case n"wea_set_shingen":
      case n"wea_set_tactician":
      case n"wea_set_testera":
      case n"wea_set_warden":
      case n"wea_set_warden_suppressor":
      case n"wea_set_zhuo":
        return true;
    }
    return false;
  }

