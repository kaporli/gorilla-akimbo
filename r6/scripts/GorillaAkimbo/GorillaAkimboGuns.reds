  public static func ReloadHideEnd(owner: CName, variant: Int32, empty: Bool) -> Float {
    if Equals(owner, n"ajax") {
      if variant == 1 {
        return (empty ? 80.0 : 70.0) / 30.0;
      }
      if variant == 2 {
        return (empty ? 80.0 : 71.0) / 30.0;
      }
