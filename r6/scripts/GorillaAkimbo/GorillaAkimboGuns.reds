// Generated by tools/anim/gen guns from weapons.json. Do not edit.
module GorillaAkimbo

public abstract class GorillaAkimboGuns {
  // Settings group of an item type; n"None" for types the mod does not handle.
  public static func Group(type: gamedataItemType) -> CName {
    if Equals(type, gamedataItemType.Wea_SubmachineGun) {
      return n"smg";
    }
    if Equals(type, gamedataItemType.Wea_Shotgun) || Equals(type, gamedataItemType.Wea_ShotgunDual) {
      return n"shotgun";
    }
    if Equals(type, gamedataItemType.Wea_Rifle) {
      return n"rifle";
    }
    if Equals(type, gamedataItemType.Wea_Handgun) {
      return n"pistol";
    }
    if Equals(type, gamedataItemType.Wea_Revolver) {
      return n"revolver";
    }
    return n"None";
  }

  // Whether guns of this item type need Gorilla Arms to be dual-wielded.
  public static func NeedsArms(type: gamedataItemType) -> Bool {
    if Equals(type, gamedataItemType.Wea_SubmachineGun) || Equals(type, gamedataItemType.Wea_Shotgun) || Equals(type, gamedataItemType.Wea_ShotgunDual) || Equals(type, gamedataItemType.Wea_Rifle) {
      return true;
    }
    return false;
  }

  // Types the mod adds the game's DualWield tag to (every handled type).
  public static func IsHandled(type: gamedataItemType) -> Bool {
    if Equals(type, gamedataItemType.Wea_SubmachineGun) || Equals(type, gamedataItemType.Wea_Shotgun) || Equals(type, gamedataItemType.Wea_ShotgunDual) || Equals(type, gamedataItemType.Wea_Rifle) || Equals(type, gamedataItemType.Wea_Handgun) || Equals(type, gamedataItemType.Wea_Revolver) {
      return true;
    }
    return false;
  }

  // Types that use the mod's own per-hand reload arm clips and lowered stance; the others use the game's
  // dual-wield sets.
  public static func UsesArmClips(type: gamedataItemType) -> Bool {
    if Equals(type, gamedataItemType.Wea_SubmachineGun) || Equals(type, gamedataItemType.Wea_Shotgun) || Equals(type, gamedataItemType.Wea_ShotgunDual) || Equals(type, gamedataItemType.Wea_Rifle) {
      return true;
    }
    return false;
  }

  // Audio set to borrow reload sounds from when a gun's own set has no table (shells: shell-by-shell reload).
  public static func FallbackAudio(type: gamedataItemType, shells: Bool) -> CName {
    if Equals(type, gamedataItemType.Wea_SubmachineGun) {
      return n"wea_set_saratoga";
    }
    if Equals(type, gamedataItemType.Wea_Shotgun) {
      return shells ? n"wea_set_carnage" : n"wea_set_crusher";
    }
    if Equals(type, gamedataItemType.Wea_ShotgunDual) {
      return n"wea_set_igla";
    }
    if Equals(type, gamedataItemType.Wea_Rifle) {
      return n"wea_set_ajax";
    }
    return n"None";
  }

  // Long partner name of a gun by its audio set, n"None" when not long.
  public static func LongPartner(audio: CName) -> CName {
    switch audio {
      case n"wea_set_carnage":
        return n"carnage";
      case n"wea_set_tactician":
        return n"tactician";
      case n"wea_set_zhuo":
        return n"zhuo";
      case n"wea_set_igla":
        return n"igla";
      case n"wea_set_testera":
        return n"testera";
      case n"wea_set_satara":
        return n"satara";
      case n"wea_set_ajax":
        return n"ajax";
      case n"wea_set_kyubi":
        return n"ajax";
      case n"wea_set_copperhead":
        return n"copperhead";
      case n"wea_set_umbra":
        return n"copperhead";
      case n"wea_set_masamune":
        return n"masamune";
      case n"wea_set_sidewinder":
        return n"sidewinder";
      case n"wea_set_hercules":
        return n"hercules";
    }
    return n"None";
  }

  // Top-magazine kind by audio set: 0 none; only guns whose two-handed clips ship.
  public static func TopMagKind(audio: CName) -> Int32 {
    switch audio {
      case n"wea_set_shingen":
        return 1;
    }
    return 0;
  }

  // Clip seconds at which the magazine is seated. Frames at 30 fps, per top-magazine kind.
  public static func TopMagSeated(kind: Int32) -> Float {
    if kind == 1 {
      return 62.0 / 30.0;
    }
    return 0.0;
  }

  // Clip length in seconds. Frames at 30 fps, per top-magazine kind.
  public static func TopMagLength(kind: Int32) -> Float {
    if kind == 1 {
      return 96.0 / 30.0;
    }
    return 0.0;
  }

  // Clip seconds at which both guns are out of view; the other gun's ammo starts going in. Frames at 30 fps, per top-magazine kind.
  public static func TopMagDown(kind: Int32) -> Float {
    if kind == 1 {
      return 46.0 / 30.0;
    }
    return 0.0;
  }

  // Start of the part of the clip that is held until the other gun's ammo is in. Frames at 30 fps, per top-magazine kind.
  public static func TopMagHoldStart(kind: Int32) -> Float {
    if kind == 1 {
      return 48.0 / 30.0;
    }
    return 0.0;
  }

  // End of the held part. Frames at 30 fps, per top-magazine kind.
  public static func TopMagHoldEnd(kind: Int32) -> Float {
    if kind == 1 {
      return 60.0 / 30.0;
    }
    return 0.0;
  }

  // Plural names of the types that need Gorilla Arms, for tooltips.
  public static func ArmsTypeNames() -> String {
    return "SMGs, shotguns and assault rifles";
  }

  // Reload arm clip layout in clip seconds, the numbers flick.py builds with. Magazine guns: a slow tip-up until
  // OpenEnd, down out of view by DropEnd, held there until HoldEnd, then the rise (RiseLength). Shell-by-shell guns
  // (_02 clips): down by PlainDrop.
  public static func OpenEnd() -> Float {
    return 1.2;
  }

  public static func DropEnd() -> Float {
    return 1.5;
  }

  public static func HoldEnd() -> Float {
    return 3.5;
  }

  public static func PlainDrop() -> Float {
    return 0.4;
  }

  public static func RiseLength() -> Float {
    return 1.1;
  }

  // The gun whose own reload sets a gun plays, by its audio set (guns that share a model variable share them);
  // n"None" for guns on the generic reload clips.
  public static func ReloadOwner(audio: CName) -> CName {
    switch audio {
      case n"wea_set_ajax":
      case n"wea_set_kyubi":
        return n"ajax";
      case n"wea_set_copperhead":
      case n"wea_set_umbra":
        return n"copperhead";
      case n"wea_set_masamune":
        return n"masamune";
      case n"wea_set_sidewinder":
        return n"sidewinder";
      case n"wea_set_hercules":
        return n"hercules";
    }
    return n"None";
  }

  // Clip seconds from which the gun, its hand and every magazine are off screen (variant: the game's random
  // reload pick 0 to 2; empty: the empty reload clip).
  public static func ReloadHideStart(owner: CName, variant: Int32, empty: Bool) -> Float {
    if Equals(owner, n"ajax") {
      if variant == 1 {
        return (empty ? 15.0 : 31.0) / 30.0;
      }
      if variant == 2 {
        return (empty ? 15.0 : 33.0) / 30.0;
      }
      return (empty ? 15.0 : 30.0) / 30.0;
    }
    if Equals(owner, n"copperhead") {
      if variant == 1 {
        return 27.0 / 30.0;
      }
      if variant == 2 {
        return 29.0 / 30.0;
      }
      return 26.0 / 30.0;
    }
    if Equals(owner, n"masamune") {
      if variant == 1 {
        return (empty ? 45.0 : 37.0) / 30.0;
      }
      if variant == 2 {
        return 33.0 / 30.0;
      }
      return (empty ? 31.0 : 30.0) / 30.0;
    }
    if Equals(owner, n"sidewinder") {
      if variant == 1 {
        return 27.0 / 30.0;
      }
      if variant == 2 {
        return 29.0 / 30.0;
      }
      return 26.0 / 30.0;
    }
    if Equals(owner, n"hercules") {
      if variant == 1 {
        return 57.0 / 30.0;
      }
      if variant == 2 {
        return 62.0 / 30.0;
      }
      return 63.0 / 30.0;
    }
    return 0.0;
  }

