<?xml version="1.0"?>
<!-- Gorilla Akimbo: the aim key used while dual-wielding with Independent firing on (Mod Settings), since both fire
     buttons then fire a gun; and the left gun key (puts the left gun away and draws it again). F2 and LB + Select
     are unused by the base game and by common mods. Rebindable in Settings > Controls > Key Bindings with Unified
     Keybinds. -->
<bindings>
  <mapping name="GorillaAkimboAim_Button" type="Button">
    <button id="IK_Mouse4" overridableUI="gorillaAkimboAim" />
    <button id="IK_Pad_LeftThumb" />
  </mapping>

  <mapping name="GorillaAkimboToggle_Button" type="Button">
    <button id="IK_F2" overridableUI="gorillaAkimboToggle" />
    <button id="IK_Pad_LeftShoulderBackSelect" />
  </mapping>

  <context name="Combat" append="true">
    <action name="GorillaAkimboAim" map="GorillaAkimboAim_Button" />
    <action name="GorillaAkimboToggle" map="GorillaAkimboToggle_Button" />
  </context>
</bindings>
